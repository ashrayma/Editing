[{"i": 0, "s": 0.08, "e": 0.89, "t": "Dear Rajat,"}, {"i": 1, "s": 1.42, "e": 3.06, "t": "I hope you know what you're doing."}, {"i": 2, "s": 3.62, "e": 5.77, "t": "Because this decision might just upset a f***."}, {"i": 3, "s": 5.89, "e": 7.36, "t": "Few people at the BCCI."}, {"i": 4, "s": 8.04, "e": 8.87, "t": "You've asked them not to."}, {"i": 5, "s": 8.87, "e": 9.79, "t": "To pick you for 50"}, {"i": 6, "s": 9.79, "e": 11.95, "t": "50 over cricket while you manage your injuries."}, {"i": 7, "s": 12.44, "e": 13.35, "t": "And honestly?"}, {"i": 8, "s": 13.74, "e": 14.39, "t": "I respect that."}, {"i": 9, "s": 14.83, "e": 16.14, "t": "Your body comes first."}, {"i": 10, "s": 16.84, "e": 18.12, "t": "But a few days later,"}, {"i": 11, "s": 18.12, "e": 19.88, "t": "You'll be leading Madhya Pradesh in a team."}, {"i": 12, "s": 19.88, "e": 21.05, "t": "T20 tournament"}, {"i": 13, "s": 21.38, "e": 22.85, "t": "And people will notice that."}, {"i": 14, "s": 23.56, "e": 25.6, "t": "So, here's a little advice from a fan."}, {"i": 15, "s": 26.22, "e": 27.63, "t": "Make it clear this is about"}, {"i": 16, "s": 27.84, "e": 28.28, "t": "Fitness"}, {"i": 17, "s": 28.55, "e": 30.04, "t": "Not about choosing formats."}, {"i": 18, "s": 30.55, "e": 30.7, "t": "Yo"}, {"i": 19, "s": 30.84, "e": 31.57, "t": "33"}, {"i": 20, "s": 32.01, "e": 33.43, "t": "You've lifted the IPL trophy."}, {"i": 21, "s": 33.43, "e": 34.68, "t": "Sophia's RCB captain"}, {"i": 22, "s": 35.17, "e": 36.77, "t": "T20 clearly suits you."}, {"i": 23, "s": 37.04, "e": 37.74, "t": "And that's okay."}, {"i": 24, "s": 38.27, "e": 40.25, "t": "But keep one door open for India."}, {"i": 25, "s": 40.74, "e": 41.58, "t": "Because selectors"}, {"i": 26, "s": 41.72, "e": 42.72, "t": "Don't wait for anyone."}, {"i": 27, "s": 43.32, "e": 45.19, "t": "Rinku is already vice captain."}, {"i": 28, "s": 45.46, "e": 47.3, "t": "and Bodoni already has your spot."}, {"i": 29, "s": 47.95, "e": 49.21, "t": "You worked so hard for-"}, {"i": 30, "s": 49.21, "e": 50.48, "t": "for that India cap Rajat"}, {"i": 31, "s": 51.0, "e": 51.16, "t": "Get"}, {"i": 32, "s": 51.28, "e": 51.48, "t": "Fit."}, {"i": 33, "s": 51.74, "e": 52.44, "t": "Skol big!"}, {"i": 34, "s": 52.67, "e": 53.95, "t": "and make them call you back."}, {"i": 35, "s": 54.49, "e": 56.55, "t": "I really hope this is a plan that pays off."}, {"i": 36, "s": 56.99, "e": 58.11, "t": "Because at 33,"}, {"i": 37, "s": 58.39, "e": 59.88, "t": "Time isn't on your side."}]