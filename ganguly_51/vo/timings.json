{
 "duration": 94.654521,
 "lines": [
  {
   "i": 0,
   "start": 2.6,
   "end": 4.42,
   "text": "Koi mujhse pooche, meri favourite Test innings kaunsi hai?"
  },
  {
   "i": 1,
   "start": 4.83,
   "end": 8.36,
   "text": "Main bolunga: Sourav Ganguly, 51 not out."
  },
  {
   "i": 2,
   "start": 8.79,
   "end": 12.47,
   "text": "Log hasenge."
  },
  {
   "i": 3,
   "start": 12.87,
   "end": 13.64,
   "text": "Bhai, yahan log 200, 300 maar dete hain... aur tum 51 pe atke ho?"
  },
  {
   "i": 4,
   "start": 13.81,
   "end": 16.38,
   "text": "Toh suno. Ye 51 runs nahi the."
  },
  {
   "i": 5,
   "start": 16.4,
   "end": 18.08,
   "text": "Ye ek statement tha."
  },
  {
   "i": 6,
   "start": 18.21,
   "end": 18.51,
   "text": "2003 World Cup final tak team ko le gaye."
  },
  {
   "i": 7,
   "start": 18.77,
   "end": 20.09,
   "text": "Poora desh pyaar se Dada bulata tha."
  },
  {
   "i": 8,
   "start": 20.23,
   "end": 21.82,
   "text": "Phir naya coach aata hai, Greg Chappell."
  },
  {
   "i": 9,
   "start": 23.44,
   "end": 24.75,
   "text": "Ek email leak hota hai."
  },
  {
   "i": 10,
   "start": 24.88,
   "end": 27.24,
   "text": "Captaincy jaati hai... aur phir team se bhi bahar."
  },
  {
   "i": 11,
   "start": 27.76,
   "end": 30.37,
   "text": "Sab bolte hain: Dada khatam."
  },
  {
   "i": 12,
   "start": 30.55,
   "end": 32.07,
   "text": "Ab wapas nahi aayega."
  },
  {
   "i": 13,
   "start": 32.35,
   "end": 38.89,
   "text": "Lagbhag ek saal baad, South Africa mein India buri tarah haar rahi thi."
  },
  {
   "i": 14,
   "start": 39.26,
   "end": 46.84,
   "text": "Aur selectors ne phir se Dada ko bulaya."
  },
  {
   "i": 15,
   "start": 47.66,
   "end": 49.82,
   "text": "Johannesburg, December 2006."
  },
  {
   "i": 16,
   "start": 49.98,
   "end": 50.31,
   "text": "Hari pitch."
  },
  {
   "i": 17,
   "start": 50.47,
   "end": 50.6,
   "text": "Saamne Pollock, Steyn, Ntini, Nel aur Kallis."
  },
  {
   "i": 18,
   "start": 50.94,
   "end": 51.32,
   "text": "Sirf pace."
  },
  {
   "i": 19,
   "start": 51.64,
   "end": 52.1,
   "text": "Sehwag out. Sachin out. Dravid out."
  },
  {
   "i": 20,
   "start": 52.56,
   "end": 52.99,
   "text": "110 pe 4."
  },
  {
   "i": 21,
   "start": 54.25,
   "end": 59.07,
   "text": "Aur andar aaye... Sourav Ganguly."
  },
  {
   "i": 22,
   "start": 59.86,
   "end": 61.08,
   "text": "Aage kya hua, jaanne se pehle..."
  },
  {
   "i": 23,
   "start": 61.1,
   "end": 64.42,
   "text": "agar aap sachche cricket fan ho, toh channel ko subscribe zaroor karna."
  },
  {
   "i": 24,
   "start": 65.24,
   "end": 67.02,
   "text": "101 balls. Har ball pe khatra."
  },
  {
   "i": 25,
   "start": 67.19,
   "end": 67.58,
   "text": "Aur Dada? 51 not out."
  },
  {
   "i": 26,
   "start": 67.77,
   "end": 68.71,
   "text": "Team ke top scorer."
  },
  {
   "i": 27,
   "start": 68.86,
   "end": 71.37,
   "text": "India 249 pe all out."
  },
  {
   "i": 28,
   "start": 71.53,
   "end": 73.01,
   "text": "Phir Sreesanth ke 5 wicket..."
  },
  {
   "i": 29,
   "start": 73.65,
   "end": 77.4,
   "text": "aur South Africa sirf 84 pe all out."
  },
  {
   "i": 30,
   "start": 77.58,
   "end": 80.94,
   "text": "India ne jeeta South Africa mein apna pehla Test. Ever."
  },
  {
   "i": 31,
   "start": 81.77,
   "end": 83.01,
   "text": "Ye 51 runs nahi the."
  },
  {
   "i": 32,
   "start": 83.32,
   "end": 86.41,
   "text": "Ye Dada ka jawab tha, har us insaan ko jisne bola tha: Dada khatam."
  },
  {
   "i": 33,
   "start": 86.65,
   "end": 90.37,
   "text": "Dada ka 51 ya Laxman ka 281?"
  },
  {
   "i": 34,
   "start": 90.64,
   "end": 94.39,
   "text": "Comment karo."
  }
 ]
}